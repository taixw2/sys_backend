{
  "name": "@english-admin/backend",
  "version": "1.0.0",
  "description": "English Admin Backend with Bun Elysia",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "clean": "rm -rf dist",
    "seed": "bun scripts/seed.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:deploy": "prisma migrate deploy",
    "import:beautiful-articles": "bun scripts/import-beautiful-articles.ts"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/static": "^1.4.0",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.11.1",
    "@types/bcrypt": "^5.0.2",
    "ali-oss": "^6.23.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.3.18",
    "crypto": "^1.0.1",
    "elysia": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.11.1",
    "prismabox": "^1.1.24",
    "svg-captcha": "^1.4.0",
    "tencentcloud-sdk-nodejs": "^4.1.123"
  },
  "devDependencies": {
    "@types/ali-oss": "^6.16.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "bun-types": "latest"
  }
}
